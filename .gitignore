# Local credentials and private account snapshots must not be committed.
/secrets/
/state/*
!/state/runtime/
/state/runtime/*
!/state/runtime/ledger.json
!/state/runtime/history/
/state/runtime/history/*
!/state/runtime/history/[0-9]*.json
!/state/bravos/
/state/bravos/*
!/state/bravos/ledger.json
!/state/bravos/history/
!/state/bravos/runs/
/state/bravos/history/*
!/state/bravos/history/*.json
/state/bravos/runs/*
!/state/bravos/runs/*.md
# Generated summaries duplicate the checkpointed state/runtime journal.
/state/bravos/runtime-ledger.json
/state/bravos/history/runtime-*.json
/state/bravos/runs/runtime-*.md
# Keep review requests/reports; raw tool responses are local artifacts.
/work/fable-review/runs/*/response.json
.env
.env.*
!.env.example
__pycache__/
/.gradle/
/build/
/config/local.json
.vfox/
